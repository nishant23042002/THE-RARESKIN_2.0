{
  "name": "rareskin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "catalog": "tsx scripts/catalog.ts",
    "revalidate": "tsx scripts/catalog.ts revalidate",
    "db:migrate": "migrate-mongo up",
    "db:migrate:down": "migrate-mongo down",
    "db:migrate:status": "migrate-mongo status",
    "db:migrate:create": "migrate-mongo create"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "cloudinary": "^2.11.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mongoose": "^9.9.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@next/env": "^16.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "migrate-mongo": "^14.0.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
