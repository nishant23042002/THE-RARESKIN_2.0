# Copy to .env.local for development, or set these in the Vercel project.
# THIS FILE IS COMMITTED — keep every value blank. Real secrets go in .env.local.
# The storefront still builds and runs with none of these set; the data layer
# (scripts, and any DB-backed page) needs at least MONGODB_URI.

# ── Site ──────────────────────────────────────────────────────────────────
# Canonical production URL, no trailing slash. Drives <link rel="canonical">,
# OpenGraph URLs, sitemap.xml, robots.txt and the OG image absolute paths.
# Leave unset locally (defaults to https://therareskin.com).
NEXT_PUBLIC_SITE_URL=https://therareskin.com

# ── Database — MongoDB Atlas ─────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers. Use a dedicated database
# user with readWrite on one database only. Separate clusters/users per
# environment — never point staging or local at the production cluster.
# If the password contains @ : / ? # [ ] it must be percent-encoded (@ = %40).
MONGODB_URI=
MONGODB_DB=rareskin

# ── Media — Cloudinary ──────────────────────────────────────────────────
# Dashboard → Account Details. The API secret signs direct browser uploads and
# must stay server-side (no NEXT_PUBLIC_ prefix).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same cloud name, exposed to the browser for the <Image> loader.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Seed / bootstrap — scripts/seed.ts only ────────────────────────────
# The first superadmin account. Phone in +91XXXXXXXXXX form; the account is
# created unverified and becomes usable after the first OTP login.
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_NAME=Owner

# ── On-demand cache revalidation (POST /api/revalidate) ────────────────
# Long random string (min 16 chars). Bearer token for the revalidate endpoint;
# `pnpm catalog set …` and the future admin use it to refresh the storefront
# cache after an edit. Leave blank to disable the endpoint.
REVALIDATE_SECRET=
# Where `pnpm catalog`/`pnpm revalidate` should POST (default http://localhost:3000).
REVALIDATE_TARGET=

# ── Auth — OTP code length ────────────────────────────────────────────
# Digits in the SMS code. MUST equal the "Code Length" set on your Twilio
# Verify Service (Console → Verify → Services → Settings). Twilio Verify
# supports 4–10; default here is 4. Exposed to the browser for the input.
NEXT_PUBLIC_OTP_LENGTH=4

# ── Auth — Twilio Verify (OTP login) ──────────────────────────────────
# Console → Account Info for the SID (AC…) + auth token. Then create a
# Verify Service (Console → Verify → Services), set its Code Length to match
# NEXT_PUBLIC_OTP_LENGTH, and paste its SID (VA…) below. A Messaging Service
# SID (MG…) is the wrong kind and is rejected.
# Blank locally → the flow falls back to AUTH_DEV_OTP. Production SMS to Indian
# numbers also needs an approved DLT entity + template (weeks of lead time).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Fixed code accepted only when Twilio is unconfigured (dev/test). Same length
# as NEXT_PUBLIC_OTP_LENGTH. Never used in production.
AUTH_DEV_OTP=

# ── Auth — Cloudflare Turnstile (bot check on the OTP form) ────────────
# Blank = check skipped. Both keys required to enable it.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Rate limiting — Upstash Redis ─────────────────────────────────────
# Sliding-window limits on OTP + checkout. Blank = in-process fallback
# (single instance only — set these in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments — Razorpay ────────────────────────────────────────────────
# Keys from https://dashboard.razorpay.com/app/keys — Test Mode until KYC is
# approved. Blank locally → checkout shows a "simulate payment" panel so the
# whole flow (order confirms, stock commits, credit issues) is testable
# without keys or a public webhook URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard → Settings → Webhooks. Point the webhook at
# https://<domain>/api/webhooks/razorpay and subscribe to: payment.captured,
# payment.failed, order.paid, refund.processed, refund.failed,
# payment.dispute.created. Configured independently of the API keys.
RAZORPAY_WEBHOOK_SECRET=

# ── Scheduled jobs (Vercel Cron) ───────────────────────────────────────
# Bearer token the /api/cron/* routes require. Set the SAME value in the
# Vercel project env — Vercel Cron sends it automatically. See vercel.json.
CRON_SECRET=

# ── Transactional email — Resend ───────────────────────────────────────
# API key from https://resend.com/api-keys. Blank locally → every order email
# is written to .mail/<key>.html instead of being sent (the outbox, retries and
# webhook idempotency all still run). Verify a sending domain first
# (Resend → Domains) so EMAIL_FROM passes SPF/DKIM.
RESEND_API_KEY=
EMAIL_FROM=THE RARESKIN <orders@therareskin.com>
# Resend → Webhooks → add https://<domain>/api/webhooks/resend, subscribe to
# email.bounced, email.complained, email.delivered. Paste the "whsec_..."
# signing secret. Verified independently of the API key.
RESEND_WEBHOOK_SECRET=

# ── Contact form — src/app/api/contact/route.ts ──────────────────────────
# The route validates and returns success; it does not send anything yet.
CONTACT_FORWARD_EMAIL=therareskinsupport@velocityventuresgroup.in

# ── Newsletter — src/app/api/newsletter/route.ts ────────────────────────
# Same: validates and returns success. Add a provider key + list id later.
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# ── Analytics (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
