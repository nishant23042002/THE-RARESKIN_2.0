# Copy to .env.local for development, or set these in the Vercel project.
# Nothing here is required for the site to build and run — the commerce and
# form integrations are stubs until you fill these in.

# ── Site ──────────────────────────────────────────────────────────────────
# Canonical production URL, no trailing slash. Drives <link rel="canonical">,
# OpenGraph URLs, sitemap.xml, robots.txt and the OG image absolute paths.
# Leave unset locally (defaults to https://therareskin.com).
NEXT_PUBLIC_SITE_URL=https://therareskin.com

# ── Payments — Razorpay (not wired yet) ───────────────────────────────────
# The checkout is a placeholder until a CommerceProvider is implemented in
# src/lib/commerce/. Keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Contact form — src/app/api/contact/route.ts ──────────────────────────
# The route validates and returns success; it does not send anything yet.
# Point it at a support inbox / helpdesk when ready.
CONTACT_FORWARD_EMAIL=therareskinsupport@velocityventuresgroup.in

# ── Newsletter — src/app/api/newsletter/route.ts ────────────────────────
# Same: validates and returns success. Add a provider (Buttondown, Resend,
# Mailchimp, …) key + list id to actually subscribe people.
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# ── Analytics (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
