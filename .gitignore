# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Local / not for GitHub
# Convention: anything that is a local working aid — not needed to build, run,
# test or deploy the app — is ignored here rather than committed. Add to this
# list whenever such a file is introduced.
# ---------------------------------------------------------------------------

# Claude Code tooling (preview launch config, local settings)
/.claude/

# AI-agent instruction files (Next regenerates AGENTS.md on `next dev`)
/AGENTS.md
/CLAUDE.md

# design exploration — local visual reference only (see design-explorations/README.md)
/design-explorations/

# editor / OS cruft
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
Thumbs.db
ehthumbs.db
Desktop.ini

# scratch space for throwaway work
/scratch/
/.scratch/
*.local
*.tmp

# rendered transactional emails (RESEND_API_KEY blank → written here for review)
/.mail/

